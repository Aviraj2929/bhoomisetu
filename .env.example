# System Configuration
PROJECT_NAME="BhoomiSetu"
API_V1_STR="/api/v1"
SECRET_KEY="bhoomisetu-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_db_password
POSTGRES_DB=bhoomisetu_db
DATABASE_URL=postgresql://postgres:secure_db_password@localhost:5432/bhoomisetu_db

# Redis & Broker Configuration
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Storage Configuration
STORAGE_TYPE=local
STORAGE_DIR=./data/storage

# AI & OCR Configuration
SARVAM_API_KEY=mock_sarvam_key
